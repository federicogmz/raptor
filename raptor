#!/usr/bin/env bash
# Lanzador de RAPTOR en el HOST.
#
# Existe por dos motivos que no se pueden resolver desde adentro del
# contenedor:
#
#  1. Las rutas que le importan al usuario son las del host, pero el pipeline
#     corre aislado y solo ve lo que esté montado. Este script recibe rutas del
#     host —incluida la carpeta de entrega— y arma los -v correspondientes, así
#     los productos salen a un disco real en vez de morir con el contenedor.
#  2. Automatización/CI necesita una invocación no interactiva, con códigos de
#     salida y una salida legible por máquina. El modo `run` por sí solo deja
#     el geovisor sirviendo para siempre (SERVE=1), que en un pipeline de CI
#     es un cuelgue.
#
# Primera vez, desde el checkout:
#   ./raptor install
# De ahí en más, desde donde sea (el instalador deja `raptor` en el PATH):
#   raptor start / stop / restart / status / logs
#
# Uso manual (bypassa la config guardada por `raptor init`):
#   ./raptor build
#   ./raptor run --input ./fotos --export ./entregas/la_clara --export-epsg 9377
#   ./raptor webapp --runs ./runs --export ./entregas
#   ./raptor shell
#
# `run --help` lista todas las opciones.
set -euo pipefail

IMAGE="${RAPTOR_IMAGE:-raptor:latest}"
AQUI="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Puntos de montaje FIJOS adentro del contenedor. El usuario nunca los escribe:
# da rutas del host y este script las mapea.
C_INPUT=/input
C_INPUT_MS=/input_ms
C_EXPORT=/export
C_IMPORT=/import
C_RUNS=/app/runs

morir() { echo "❌ $*" >&2; exit 2; }

abs() {  # ruta absoluta NORMALIZADA (sin ./ ni ..), sin exigir que exista.
  # Antes solo anteponía $PWD, así que "./entregas" quedaba literalmente
  # como ".../raptor/./entregas" — EXPORT_HOST_DIR/IMPORT_HOST_DIR se
  # guardaban con ese "./" adentro, pero el lado de la webapp que compara
  # una ruta contra esa (host_a_contenedor()/import_host_a_contenedor() en
  # webapp/main.py) SÍ normaliza con os.path.normpath() antes de comparar
  # — el "./" nunca desaparecía del lado de EXPORT_HOST_DIR, así que la
  # comparación de prefijo fallaba SIEMPRE, incluso para una ruta
  # correcta, con el mensaje "está fuera de la carpeta montada" apuntando
  # a la carpeta correcta. realpath -m normaliza sin pedir que la carpeta
  # ya exista (esto corre ANTES del mkdir -p que la crea).
  local p="$1"
  [[ "$p" = /* ]] || p="$PWD/$p"
  realpath -m "$p"
}

gpu_args() {
  if [[ "${NO_GPU:-0}" -eq 1 ]]; then return; fi
  if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1; then
    printf '%s' "--gpus all"
  else
    echo "ℹ  Sin GPU detectada — ODM correrá en CPU (más lento)." >&2
  fi
}

asegurar_docker() {
  if docker info >/dev/null 2>&1; then
    return 0
  fi

  echo "🐳 Docker no está corriendo. Iniciando en segundo plano…" >&2

  # 1. Intentar iniciar vía servicio systemd de usuario (si existe)
  if command -v systemctl >/dev/null 2>&1; then
    systemctl --user start docker.service >/dev/null 2>&1 || true
  fi

  # 2. Si todavía no responde, intentar con dockerd-rootless.sh directamente
  if ! docker info >/dev/null 2>&1; then
    local rootless_bin=""
    if command -v dockerd-rootless.sh >/dev/null 2>&1; then
      rootless_bin="dockerd-rootless.sh"
    elif [[ -x "$HOME/.local/docker/bin/dockerd-rootless.sh" ]]; then
      rootless_bin="$HOME/.local/docker/bin/dockerd-rootless.sh"
    fi

    if [[ -n "$rootless_bin" ]]; then
      nohup "$rootless_bin" >/dev/null 2>&1 &
    fi
  fi

  # 3. Esperar hasta 15 segundos a que el daemon esté listo
  local timeout=15
  local count=0
  while ! docker info >/dev/null 2>&1; do
    sleep 1
    count=$((count + 1))
    if [[ $count -ge $timeout ]]; then
      morir "No se pudo conectar con Docker tras ${timeout}s. Verificá que dockerd esté funcionando."
    fi
  done
  echo "✅ Docker iniciado." >&2
}

uso_run() {
  cat <<'EOF'
Uso: ./raptor run [opciones]

Entrada (al menos una):
  --input DIR              Carpeta del vuelo RGB/térmico (M3T/H20T)
  --input-ms DIR           Carpeta del vuelo multiespectral (M3M)

Procesamiento:
  --mode MODO              rgb+thermal (default) | rgb | none
  --preset NOMBRE          Qué tan fino y cuánto tarda. Default: cartografico.
                             tactico       respuesta inmediata en campo
                             cartografico  la entrega normal de una misión
                             forense       peritaje y archivo
                           (siguen aceptándose los nombres viejos: vistazo,
                           rapido, estandar, alta, maxima.)
                           Cada preset fija el detalle del modelo de
                           superficie, el techo de resolución del ortomosaico/
                           DSM (nunca más fino que el GSD real del vuelo), los
                           features por foto y el bundle adjustment. Antes de
                           arrancar se muestran los tres con su tiempo
                           estimado para TUS fotos y TU hardware.
  --quality N              (heredado) 0-100; se mapea al preset equivalente.
  --terreno TIPO           plano (default) | escarpado
                           Se mantiene por compatibilidad: todos los presets
                           actuales ya reconstruyen en modo incremental (planar
                           puede descartar la mayoría de las fotos SIN avisar
                           en relieve fuerte), así que hoy no cambia nada.
  --subsample N            MODO URGENCIA: procesar 1 de cada N fotos (N>=2,
                           p. ej. 3). Corta el tiempo del SfM casi a la
                           tercera parte — la palanca más grande en terreno
                           escarpado, donde la reconstrucción incremental es
                           secuencial. El mosaico pierde detalle de solape;
                           las originales quedan intactas en la fuente y se
                           restauran solas en la próxima corrida.
  --reuse-odm              Reusar reconstrucciones ODM previas de --runs
  --max-concurrency N      Hilos de ODM (default: según la RAM disponible;
                           se detecta y se reparte solo por sensor/etapa)
  --no-gpu                 Forzar CPU
  --verbose                Salida cruda de ODM y de los scripts

Entrega (rutas del HOST; se montan solas):
  --export DIR             Carpeta de destino de los productos
  --export-products LISTA  Coma-separado, o "all" (default)
                           rgb,thermal,dsm,multispectral,indices,classes,
                           confidence,area,flight_path,situation,pointclouds
  --export-epsg CODIGO     EPSG de salida (9377 = MAGNA-SIRGAS/Origen-Nacional,
                           el sistema único nacional de Colombia) o "source"
  --export-raster-format F cog (default) | gtiff
  --export-vector-format F geojson (default) | gpkg | shp | kml

Persistencia y automatización:
  --runs DIR               Carpeta de trabajo persistente (default: ./runs)
  --json                   Imprimir el resumen JSON de la corrida al terminar
  --serve                  Dejar el geovisor sirviendo al terminar (por
                           defecto NO: en CI eso sería un cuelgue)
  --port N                 Puerto del geovisor si se usa --serve

Sale con código != 0 si el pipeline falla, para poder encadenarlo en CI.
EOF
}

cmd_build() {
  asegurar_docker
  echo "🔨 Construyendo ${IMAGE}…"
  docker build -t "$IMAGE" "$AQUI" "$@"
}

cmd_run() {
  local input="" input_ms="" export_dir="" runs="$PWD/runs"
  local mode="rgb+thermal" preset="" quality="" terreno="plano" reuse=0 verbose=0 json=0 serve=0 port=8080 subsample=0
  local products="all" epsg="source" rfmt="cog" vfmt="geojson" concurrency=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --input)                 input="$2"; shift 2 ;;
      --input-ms)              input_ms="$2"; shift 2 ;;
      --export)                export_dir="$2"; shift 2 ;;
      --export-products)       products="$2"; shift 2 ;;
      --export-epsg)           epsg="$2"; shift 2 ;;
      --export-raster-format)  rfmt="$2"; shift 2 ;;
      --export-vector-format)  vfmt="$2"; shift 2 ;;
      --runs)                  runs="$2"; shift 2 ;;
      --mode)                  mode="$2"; shift 2 ;;
      --preset)                preset="$2"; shift 2 ;;
      --quality)               quality="$2"; shift 2 ;;
      --terreno)               terreno="$2"; shift 2 ;;
      --subsample)             subsample="$2"; shift 2 ;;
      --max-concurrency)       concurrency="$2"; shift 2 ;;
      --port)                  port="$2"; shift 2 ;;
      --reuse-odm)             reuse=1; shift ;;
      --no-gpu)                NO_GPU=1; shift ;;
      --verbose)               verbose=1; shift ;;
      --json)                  json=1; shift ;;
      --serve)                 serve=1; shift ;;
      -h|--help)               uso_run; exit 0 ;;
      *) morir "opción desconocida: $1  (./raptor run --help)" ;;
    esac
  done

  [[ -z "$input" && -z "$input_ms" ]] && morir "hace falta --input y/o --input-ms  (./raptor run --help)"
  case "$mode" in rgb|rgb+thermal|none) ;; *) morir "--mode inválido: $mode (rgb, rgb+thermal o none)" ;; esac
  [[ -z "$input" && "$mode" != "none" ]] && morir "sin --input, --mode tiene que ser 'none' (solo multiespectral)"
  # --preset gana; --quality N sigue aceptándose (se mapea adentro del
  # contenedor, ver PRESET en docker/entrypoint.sh). El nombre en sí lo valida
  # scripts/hardware.py, que es donde vive la tabla — replicar la lista acá
  # sería una segunda copia para desincronizar.
  if [[ -n "$quality" ]]; then
    [[ "$quality" =~ ^[0-9]+$ && "$quality" -le 100 ]] || morir "--quality tiene que ser un entero 0-100 (recibido: $quality)"
    [[ -n "$preset" ]] && morir "usá --preset o --quality, no los dos"
    preset="$quality"
  fi
  [[ -z "$preset" ]] && preset="cartografico"
  case "$terreno" in plano|escarpado) ;; *) morir "--terreno inválido: $terreno (plano o escarpado)" ;; esac
  if [[ "$subsample" != 0 ]]; then
    [[ "$subsample" =~ ^[0-9]+$ && "$subsample" -ge 2 ]] \
      || morir "--subsample tiene que ser un entero >= 2 (recibido: $subsample)"
    [[ "$reuse" -eq 0 ]] || morir "--subsample no aplica con --reuse-odm (no se reconstruye nada)"
  fi

  local args=(--rm -e "MODE=$mode" -e "SKIP_ODM=$reuse" -e "VERBOSE=$verbose" -e "PRESET=$preset" -e "TERRENO=$terreno" -e "SUB_SAMPLE=$subsample")
  [[ -n "$concurrency" ]] && args+=(-e "MAX_CONCURRENCY=$concurrency")

  if [[ -n "$input" ]]; then
    input="$(abs "$input")"
    [[ -d "$input" ]] || morir "--input no existe: $input"
    args+=(-v "$input:$C_INPUT:ro")
  fi
  if [[ -n "$input_ms" ]]; then
    input_ms="$(abs "$input_ms")"
    [[ -d "$input_ms" ]] || morir "--input-ms no existe: $input_ms"
    args+=(-v "$input_ms:$C_INPUT_MS:ro")
  else
    # Sin esto el entrypoint encontraría un /input_ms heredado de la imagen
    args+=(-e "MS_SOURCE_DIR=/sin_multiespectral")
  fi

  runs="$(abs "$runs")"; mkdir -p "$runs"
  args+=(-v "$runs:$C_RUNS")

  if [[ -n "$export_dir" ]]; then
    export_dir="$(abs "$export_dir")"
    # Se crea DESDE EL HOST a propósito: así queda del usuario y no de root,
    # que es lo que pasa cuando el directorio lo crea el contenedor.
    mkdir -p "$export_dir" 2>/dev/null || morir "no se pudo crear la carpeta de entrega: $export_dir"
    [[ -w "$export_dir" ]] || morir "sin permiso de escritura en: $export_dir"
    args+=(-v "$export_dir:$C_EXPORT"
           -e "EXPORT_DIR=$C_EXPORT"
           -e "EXPORT_PRODUCTS=$products"
           -e "EXPORT_EPSG=$epsg"
           -e "EXPORT_RASTER_FORMAT=$rfmt"
           -e "EXPORT_VECTOR_FORMAT=$vfmt"
           -e "EXPORT_HOST_DIR=$export_dir")
  fi

  if [[ "$serve" -eq 1 ]]; then
    args+=(-e "SERVE=1" -e "PORT=$port" -p "${port}:${port}")
  else
    # El default del contenedor es SERVE=1 y dejaría el proceso sirviendo para
    # siempre: en CI eso es un cuelgue, no un éxito.
    args+=(-e "SERVE=0")
  fi

  # Mensaje de "a qué resolución y en cuánto tiempo" antes de la corrida real
  # — mismo cálculo que ve la webapp, mismo comando que se puede correr suelto
  # (./raptor run ... --preset X sin --input real no aplica; ver docker
  # entrypoint.sh, modo `quality-estimate`). Best-effort: si por lo que sea
  # esto falla, no bloquea el procesamiento real que es lo que importa.
  asegurar_docker
  local est_args=(--rm -e "PRESET=$preset" -e "MODE=$mode" -e "TERRENO=$terreno" -e "SUB_SAMPLE=$subsample")
  [[ -n "$input" ]] && est_args+=(-v "$input:$C_INPUT:ro")
  [[ -n "$input_ms" ]] && est_args+=(-v "$input_ms:$C_INPUT_MS:ro")
  docker run "${est_args[@]}" "$IMAGE" quality-estimate 2>/dev/null || true
  echo ""

  # shellcheck disable=SC2046
  docker run "${args[@]}" $(gpu_args) "$IMAGE" run
  local status=$?

  if [[ "$json" -eq 1 ]]; then
    local resumen="$runs/outputs/run_summary.json"
    [[ -n "$export_dir" && -f "$export_dir/run_summary.json" ]] && resumen="$export_dir/run_summary.json"
    if [[ -f "$resumen" ]]; then cat "$resumen"; else
      echo "{\"ok\": false, \"error\": \"no se generó run_summary.json\"}"
    fi
  fi
  return $status
}

cmd_webapp() {
  local runs="$PWD/runs" export_dir="" import_dir="" port=8080 name="raptor-web" fg=0
  local -a envs=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --runs)    runs="$2"; shift 2 ;;
      --export)  export_dir="$2"; shift 2 ;;
      --import)  import_dir="$2"; shift 2 ;;
      --port)    port="$2"; shift 2 ;;
      --name)    name="$2"; shift 2 ;;
      --env)     envs+=("$2"); shift 2 ;;
      --no-gpu)  NO_GPU=1; shift ;;
      --fg)      fg=1; shift ;;
      -h|--help)
        cat <<'EOF'
Uso: raptor webapp [--runs DIR] [--export DIR] [--import DIR] [--port N] [--name NOMBRE] [--env VAR=VALOR] [--no-gpu] [--fg]

Despliegue manual con flags explícitos — para el uso normal, «raptor init»
(una vez) + «raptor start» ya cubre esto sin tener que repetir --export/
--port en cada llamada, ver «raptor --help».

Por defecto queda corriendo en segundo plano y se reinicia sola si se cae
el contenedor o se reinicia la máquina (--restart unless-stopped) — pensado
para instalarla una vez y dejarla andando sin volver a ejecutar este comando.

  --name NOMBRE     Nombre del contenedor (default: raptor-web). Si ya existe
                     uno con ese nombre, se reemplaza (SOLO ese contenedor).
  --env VAR=VALOR   Variable de entorno extra para el contenedor (repetible).
                     Ej.: --env RAPTOR_ODM_PARALELO=3 --env MAX_CONCURRENCY=8
  --fg              No hacer deploy persistente: correr en primer plano,
                     pegado a la terminal, sin --restart (para debug).

raptor logs     Ver el log en vivo de la webapp persistente
raptor stop      Parar la webapp persistente
raptor status    Ver si está corriendo
EOF
        exit 0 ;;
      *) morir "opción desconocida: $1" ;;
    esac
  done
  asegurar_docker
  runs="$(abs "$runs")"; mkdir -p "$runs"
  local args=(-p "${port}:${port}" -v "$runs:$C_RUNS" -e "PORT=$port")
  if [[ -n "$export_dir" ]]; then
    export_dir="$(abs "$export_dir")"
    mkdir -p "$export_dir" 2>/dev/null || morir "no se pudo crear la carpeta de entrega: $export_dir"
    # EXPORT_HOST_DIR le dice a la webapp qué ruta del HOST hay detrás de
    # /export, para que el formulario muestre y pida rutas reales del disco del
    # usuario en vez de rutas internas del contenedor.
    args+=(-v "$export_dir:$C_EXPORT" -e "EXPORT_HOST_DIR=$export_dir")
  fi
  if [[ -n "$import_dir" ]]; then
    import_dir="$(abs "$import_dir")"
    [[ -d "$import_dir" ]] || morir "--import no existe: $import_dir"
    # Solo lectura: importar nunca tiene que poder tocar las fotos
    # originales del usuario. Mismo patrón que EXPORT_HOST_DIR, para que el
    # formulario ofrezca "copiar desde acá" con rutas reales del disco del
    # usuario en vez de subir cada foto por el navegador (mismo equipo, no
    # hace falta pasar por HTTP para duplicar algo que ya está en disco).
    args+=(-v "$import_dir:$C_IMPORT:ro" -e "IMPORT_HOST_DIR=$import_dir")
  fi
  for e in "${envs[@]}"; do args+=(-e "$e"); done
  if [[ -d "/mnt/f" ]]; then
    args+=(-v "/mnt/f:/mnt/f")
  fi

  if [[ "$fg" -eq 1 ]]; then
    echo "🌐 http://localhost:${port} (primer plano, sin --restart)"
    # shellcheck disable=SC2046
    docker run --rm "${args[@]}" $(gpu_args) "$IMAGE" webapp
    return $?
  fi

  # Deploy persistente: nombre fijo para poder reemplazar SOLO este
  # contenedor en la próxima corrida (nunca un `docker ps -aq` a ciegas —
  # este mismo daemon puede tener contenedores de otros proyectos corriendo).
  if [[ -n "$(docker ps -aq -f "name=^/${name}\$")" ]]; then
    echo "🔁 Reemplazando contenedor previo «${name}»…"
    docker rm -f "$name" >/dev/null
  fi
  args+=(-d --name "$name" --restart unless-stopped)
  # shellcheck disable=SC2046
  docker run "${args[@]}" $(gpu_args) "$IMAGE" webapp >/dev/null
  echo "🌐 http://localhost:${port}  (persistente — sobrevive reinicios de la máquina si Docker arranca solo)"
  echo "   raptor logs   → ver el progreso en vivo"
  echo "   raptor stop   → apagarla"
  echo "   raptor status → ver si está corriendo"
}

cmd_stop() {
  asegurar_docker
  local name="${1:-raptor-web}"
  docker stop "$name" >/dev/null 2>&1 && echo "🛑 ${name} detenido." || echo "ℹ  ${name} no estaba corriendo."
}

cmd_logs() {
  asegurar_docker
  local name="${1:-raptor-web}"
  docker logs -f "$name"
}

cmd_status() {
  asegurar_docker
  local name="${1:-raptor-web}"
  local row
  row="$(docker ps -a -f "name=^/${name}\$" --format '{{.Status}}')"
  if [[ -z "$row" ]]; then
    echo "ℹ  ${name}: no existe (todavía no se desplegó — raptor start)"
  else
    echo "${name}: ${row}"
  fi
}

# ── Configuración persistente (carpeta de entrega + puerto), una sola vez
# en la vida de la instalación, para que start/restart no necesiten flags —
# la alternativa a repetir --export/--port en cada despliegue manual. ──
RAPTOR_CONFIG="$HOME/.raptor/config"

cmd_init() {
  echo "Configuremos RAPTOR (podés volver a correr esto cuando quieras para cambiarlo)."
  local default_export="$HOME/raptor-deliveries"
  local export_dir port
  read -rp "Carpeta de entregas (dónde quedan los productos exportados) [$default_export]: " export_dir
  export_dir="${export_dir:-$default_export}"
  export_dir="$(abs "$export_dir")"
  mkdir -p "$export_dir" 2>/dev/null || morir "no se pudo crear la carpeta de entregas: $export_dir"

  read -rp "Puerto [8080]: " port
  port="${port:-8080}"
  [[ "$port" =~ ^[0-9]+$ ]] || morir "puerto inválido: $port"

  local runs_dir="$HOME/.raptor/runs"
  mkdir -p "$runs_dir"

  mkdir -p "$(dirname "$RAPTOR_CONFIG")"
  cat > "$RAPTOR_CONFIG" <<EOF
RAPTOR_EXPORT_DIR=$export_dir
RAPTOR_PORT=$port
RAPTOR_RUNS_DIR=$runs_dir
EOF
  echo "✅ Guardado en $RAPTOR_CONFIG"
  echo "   Entregas: $export_dir"
  echo "   Puerto:   $port"
}

cmd_start() {
  [[ -f "$RAPTOR_CONFIG" ]] || morir "todavía no hay configuración — corré «raptor init» primero (o «raptor install» si es la primera vez)."
  # shellcheck disable=SC1090
  source "$RAPTOR_CONFIG"
  cmd_webapp --export "$RAPTOR_EXPORT_DIR" --runs "$RAPTOR_RUNS_DIR" --port "$RAPTOR_PORT" "$@"
}

cmd_restart() {
  echo "🔁 Reiniciando…"
  cmd_start "$@"
}

# Instala el comando global `raptor` (sin ./) delegando SIEMPRE a este mismo
# checkout — no copia el código a otro lado, así que un `git pull` acá lo
# actualiza también para el comando global, sin reinstalar nada.
_instalar_shim() {
  local dir
  for dir in /usr/local/bin "$HOME/.local/bin"; do
    if { [[ -d "$dir" ]] || mkdir -p "$dir" 2>/dev/null; } && [[ -w "$dir" ]]; then
      cat > "$dir/raptor" <<EOF
#!/usr/bin/env bash
exec "$AQUI/raptor" "\$@"
EOF
      chmod +x "$dir/raptor"
      echo "✅ Comando «raptor» instalado en $dir/raptor"
      case ":${PATH}:" in
        *":${dir}:"*) ;;
        *) echo "⚠  $dir no está en tu PATH todavía. Agregá esto a tu ~/.bashrc o ~/.zshrc:"
           echo "     export PATH=\"$dir:\$PATH\"" ;;
      esac
      return 0
    fi
  done
  echo "⚠  No se pudo instalar el comando global (sin permiso de escritura en /usr/local/bin ni ~/.local/bin) — seguí usando ./raptor desde $AQUI."
  return 1
}

cmd_install() {
  command -v docker >/dev/null 2>&1 || morir "Docker no está instalado. Instalalo y volvé a correr «./raptor install»."
  asegurar_docker

  echo "🔨 Construyendo la imagen…"
  cmd_build

  _instalar_shim || true

  cmd_init
  cmd_start
}

case "${1:-}" in
  install) shift; cmd_install "$@" ;;
  init)   shift; cmd_init "$@" ;;
  start)  shift; cmd_start "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  build)  shift; cmd_build "$@" ;;
  run)    shift; cmd_run "$@" ;;
  webapp) shift; cmd_webapp "$@" ;;
  stop)   shift; cmd_stop "$@" ;;
  logs)   shift; cmd_logs "$@" ;;
  status) shift; cmd_status "$@" ;;
  shell)  shift; asegurar_docker; docker run --rm -it -v "$PWD:/app" "$IMAGE" shell ;;
  -h|--help|"")
    cat <<'EOF'
RAPTOR — UAV photogrammetric processing pipeline (DJI M3T/H20T/M3M)

First time:
  ./raptor install             Build, install the global `raptor` command,
                                ask where deliverables go and which port,
                                and start the webapp. Run once from the
                                checkout; everything after that is just
                                `raptor ...` from anywhere.

Everyday use (after install):
  raptor start                 Start the webapp with the saved config
  raptor restart                Restart it (same as start)
  raptor stop                   Stop it
  raptor status                 Check if it's running
  raptor logs                   Watch its live log
  raptor init                   Change the deliveries folder or port

Advanced / power user:
  raptor build                 Build the image by hand
  raptor run     [options]     Process one mission, non-interactive (CI)
  raptor webapp  [options]     Deploy the webapp with explicit flags,
                                bypassing the saved config
  raptor shell                  Shell inside the container

`raptor run --help` / `raptor webapp --help` for the rest of the options.
EOF
    ;;
  *) morir "comando desconocido: $1  (raptor --help)" ;;
esac
