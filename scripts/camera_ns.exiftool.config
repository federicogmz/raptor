#------------------------------------------------------------------------------
# Namespace XMP "Camera" (http://pix4d.com/camera/1.0) para poder ESCRIBIR
# Camera:BandName con exiftool -- por defecto exiftool solo sabe LEER tags de
# namespaces no registrados, no escribirlos. Este es el mismo namespace/prefijo
# que usan los TIFF multiespectrales del DJI M3M (confirmado con `exiftool -xmp
# -b`), y el que lee opendm/photo.py::get_xmp_tag(['Camera:BandName', ...])
# para detectar la banda de cada foto -- necesario para que ODM reconozca nuestros
# TIFF térmicos re-encodeados como banda "LWIR" (ver prepare_thermal_native_odm.py).
#------------------------------------------------------------------------------
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        Camera => {
            SubDirectory => {
                TagTable => 'Image::ExifTool::UserDefined::Camera',
            },
        },
    },
);

%Image::ExifTool::UserDefined::Camera = (
    GROUPS => { 0 => 'XMP', 1 => 'XMP-Camera', 2 => 'Camera' },
    NAMESPACE => { 'Camera' => 'http://pix4d.com/camera/1.0' },
    WRITABLE => 'string',
    BandName => { },
);

1;
