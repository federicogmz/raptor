# ═══════════════════════════════════════════════════════════════════
# RAPTOR .gitignore
# ═══════════════════════════════════════════════════════════════════

# Datos y resultados del pipeline (regenerables; repo = código + docs, no datos)
data/
data
processing/
processing
preprocessing/
preprocessing
outputs/
outputs
geovisor/tiles/
geovisor/tiles
runs/
agisoft/

# Manuscrito y análisis de paper (mantenido fuera del repositorio de código)
paper/

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
.freebuff/
.pytest_cache/
.coverage
htmlcov/

# Node / JS / Scratch temporal
node_modules/
package-lock.json
scratch/
scratch*
screenshot*
take_screenshots*

# Asistentes / IDEs
.claude/
.agents/

# SDK (se incluye extraído pero no el zip)
*.zip

# Entregas exportadas y sesiones
entregas/
sessions/
projects/

# Capturas de pantalla y temporales
/*.png
*.log
*.aux.xml
*.tmp
.DS_Store
Thumbs.db
